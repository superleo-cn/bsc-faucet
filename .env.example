# Faucet Configuration

# Server Configuration
PORT=8080
RATE_LIMIT_IP=30
ENABLE_METRICS=true

# BSC Chain Configuration
BSC_PRIVATE_KEY=0xYOUR_BSC_PRIVATE_KEY
BSC_RPC_URL=https://bsc-testnet.bnbchain.org
# 若发放 BEP20 代币, 填合约地址; 留空表示原生 BNB
BSC_TOKEN_CONTRACT=0xe0a6aff263efB72E90dEdd07B9973157ee3CEc3c
# 人类可读数量 (会依据 TOKEN_DECIMALS 转成 claimAmount 原始单位)
BSC_CLAIM_AMOUNT_TOKENS=100
BSC_TOKEN_DECIMALS=18
BSC_COOLDOWN_HOURS=24
BSC_CHAIN_ID=97        # 97 for BSC Testnet, 56 for BSC Mainnet

# Ethereum Configuration
ETH_PRIVATE_KEY=0xYOUR_ETH_PRIVATE_KEY
ETH_RPC_URL=https://rpc.ankr.com/eth/f579ae585bccd9837be59a9df117deec8d866bc0e71472cbddad99b495fb07db
# 若发放 ERC20 代币, 填合约地址; 留空表示原生 ETH
ETH_TOKEN_CONTRACT=
ETH_CLAIM_AMOUNT_TOKENS=0.01
ETH_TOKEN_DECIMALS=18
ETH_COOLDOWN_HOURS=24
ETH_CHAIN_ID=1         # 1 for Ethereum Mainnet, 11155111 for Sepolia

